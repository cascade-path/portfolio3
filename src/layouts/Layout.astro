---
const { title = "no title" } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Kosugi+Maru&family=Mochiy+Pop+One&family=New+Tegomin&family=Noto+Sans+JP:wght@100..900&family=Noto+Serif+JP:wght@200..900&display=swap" rel="stylesheet">
		<!--<link rel="icon" href="/favicon.ico" />-->
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={title} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/ogp.png" />
		<meta property="og:description" content="cascade-pathのポートフォリオサイトです。" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script is:client>
  const header = document.querySelector('header');
  const headerScrolled = document.querySelector('header[data-scrolled]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          // 元の位置が画面外
          headerScrolled.setAttribute('data-fixed', 'true');
        } else {
          // 元の位置が画面内
          headerScrolled.setAttribute('data-fixed', 'false');
        }
      });
    },
    { threshold: 0 }
  );

  observer.observe(header);
</script>

	</body>
</html>

<style>
	:root{
		--base: #333;
	    --main: #0bd;
		--accent: #fff;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: var(--base);
		color: var(--accent);
		overscroll-behavior: none;
	}
</style>
