---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import H1 from '../../components/H1.astro';
import H2 from '../../components/H2.astro';
import Main from '../../components/Main.astro';
import Section from '../../components/Section.astro';
import Damy from '../../components/Damy.astro';
---

<Layout title="about | cascade-path">
	<Header />
	<H1>概要/about</H1>
    <Main>
        <H2>cascade-path</H2>
        <Section data-reverse="true">
            <div class="h2-img">
                <img src="favicon.svg" alt="about">
            </div>
            <div>
                <p>cascade-pathは、フロントエンドの個人プロジェクトです。主にWeb開発に関するコンテンツを提供しています。</p>
                <p>独学でWeb制作を学び、コーディングを中心にサイト制作をしています。</p>
                <p>CSSの表現限界に挑戦する制作などを行なっています。</p>
                <p>独自ドメイン、レンタルサーバ、Vercelを活用し、公開環境を構築しました。</p>
                <p>CSSの表現力を得意とし、サイトの目的を意識した再現性の高いUIを意識して制作しています。</p>
            </div>
            <Damy />
        </Section>
    </Main>
    <Footer />
</Layout>
