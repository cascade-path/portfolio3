---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import H1 from '../../components/H1.astro';
import H2 from '../../components/H2.astro';
import Main from '../../components/Main.astro';
import Section from '../../components/Section.astro';
import Damy from '../../components/Damy.astro';
---

<Layout title="about | cascade-path">
	<Header />
	<H1>概要/about</H1>
    <Main>
        <H2>cascade-path</H2>
        <Section data-reverse="true">
            <div class="h2-img">
                <img src="favicon.svg" alt="about">
            </div>
            <div>
                <p>cascade-pathは、フロントエンドの個人プロジェクトです。主にWeb開発に関するコンテンツを提供しています。</p>
                <p>CSSの表現限界に挑戦する制作などを行なっています。</p>
                <p>このサイトでは、プロジェクトの紹介、技術スタック、開発ブログ、そしてお問い合わせフォームなどを掲載しています。</p>
                <p>私の目標は、フロントエンド開発の最新トレンドやベストプラクティスを共有し、同じ興味を持つ人々と交流することです。</p>
            </div>
            <Damy />
        </Section>
    </Main>
    <Footer />
</Layout>
