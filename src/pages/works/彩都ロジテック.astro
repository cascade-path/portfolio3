---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import H1 from '../../components/H1.astro';
import H2 from '../../components/H2.astro';
import Main from '../../components/Main.astro';
import Table from '../../components/ui/Table.astro';
import WorksImg from '../../components/ui/WorksImg.astro';
import BtnBack from '../../components/ui/BtnBack.astro'
---

<Layout title="彩都ロジテック | cascade-path">
	<Header />
	<H1>制作実績:彩都ロジテック</H1>
    <Main>
        <WorksImg SRC="https://portfolio.cascade-path.com/wp-content/uploads/2026/04/b545db1d383b7f4d9339d3bf505a349f-2048x1624.jpeg" />
        <Table rows={[
            { left: "公開日", right: "2026年4月" },
            { left: "規模", right: "9ページ(+6予定)" },
            { left: "技術", right: "PHP/CSS" },
            { left: "制作期間", right: "未完成" },
            { left: "制作環境", right: "WordPress/VS Code" },
            { left: "公開リンク", right: "https://wordpress.cascade-path.com/info" },
        ]} />
        <H2>制作過程</H2>
        <h3>デザイン</h3>
        <WorksImg SRC="https://portfolio.cascade-path.com/wp-content/uploads/2026/04/e9dc44b69e71162ea82d29f010ceb095-2048x1423.png" />
        <h3>GoogleAdSense</h3>
        <WorksImg SRC="https://portfolio.cascade-path.com/wp-content/uploads/2026/04/e29072a7c0b2f39e1b2cae501bf506a7-2048x1442.png" />
        <h2>まとめ</h2>
        <BtnBack HREF="/works">一覧に戻る</BtnBack>
    </Main>
    <Footer />
</Layout>
