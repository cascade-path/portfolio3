---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import H1 from '../../components/H1.astro';
import H2 from '../../components/H2.astro';
import Main from '../../components/Main.astro';
import Table from '../../components/ui/Table.astro';
import WorksImg from '../../components/ui/WorksImg.astro';
import BtnBack from '../../components/ui/BtnBack.astro'
import CalcIframe from '../../components/ui/CalcIframe.astro'
---

<Layout title="制作実績:CSS電卓 | cascade-path">
	<Header />
	<H1>制作実績:「CSS電卓」</H1>
    <Main>
        <WorksImg SRC="https://res.cloudinary.com/drzcql6d4/image/upload/q_auto/f_auto/v1780557985/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88_2026-05-16_10.33.49_w0sven.png" />
        <Table rows={[
            { left: "公開日", right: "2025年9月" },
            { left: "規模", right: "6バージョン" },
            { left: "技術", right: "HTML/CSS" },
            { left: "制作期間", right: "3ヶ月" },
            { left: "制作環境", right: "CodePen" },
            { left: "デモ", right: "https://codepen.io/cascade-path/pen/WbGzwdG" },
            { left: "公開リンク", right: "https://github.com/cascade-path/calculator" },
        ]} />
        <H2>実物</H2>
        <h3>Version1.0</h3>
        <div>計算結果をダミー要素に代入、@containerで参照</div>
        <CalcIframe SRC="https://cascade-path.github.io/calculator/calc_1.html" />
        <h3>Version2.0</h3>
        <div>contentを0~9までアニメーション切り替え、計算結果をanimation-iteration-countに代入</div>
        <CalcIframe SRC="https://cascade-path.github.io/calculator/calc_2.html" />
        <h3>Version3.0</h3>
        <div>8桁対応</div>
        <CalcIframe SRC="https://cascade-path.github.io/calculator/calc_3.html" />
        <h3>Version4.0</h3>
        <div>小数対応</div>
        <CalcIframe SRC="https://cascade-path.github.io/calculator/calc_5.html" />
        <h3>Version5.0</h3>
        <div>小数同士の計算、バックスペースに対応</div>
        <CalcIframe SRC="https://cascade-path.github.io/calculator/calc_0.html" />
        <p></p>
        <img src="https://portfolio.cascade-path.com/wp-content/uploads/2026/04/97ee1196cbba82ab797eb312ee84f5a6-1.gif" >
        <div>PV-count CodePen:999, Reddit:32000+</div>
        <p></p>
        <h2>まとめ</h2>
        <div>CSS限界シリーズのその他作品はCodePenにて公開中！</div>
        <div>閲覧はフッターのリンクから</div>
        <p></p>
        <BtnBack HREF="/works">一覧に戻る</BtnBack>
    </Main>
    <Footer />
</Layout>