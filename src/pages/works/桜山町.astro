---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import H1 from '../../components/H1.astro';
import H2 from '../../components/H2.astro';
import Main from '../../components/Main.astro';
import Table from '../../components/ui/Table.astro';
import WorksImg from '../../components/ui/WorksImg.astro';
import BtnBack from '../../components/ui/BtnBack.astro'
---

<Layout title="制作実績:桜山町 | cascade-path">
	<Header />
	<H1>制作実績:桜山町のホームページ</H1>
    <Main>
        <WorksImg SRC="https://portfolio.cascade-path.com/wp-content/uploads/2026/04/fd58a0445d52bae951586692f841e2d3-edited-1.jpeg" />
        <Table rows={[
            { left: "公開日", right: "2026年1月" },
            { left: "規模", right: "1ページ" },
            { left: "技術", right: "HTML/CSS/JS" },
            { left: "制作期間", right: "1週間" },
            { left: "制作環境", right: "VS Code" },
            { left: "公開リンク", right: "https://cascade-path.github.io/sakurayama-town" },
        ]} />
        <H2>制作過程</H2>
        <h3>マークアップ</h3>
        <WorksImg SRC="https://portfolio.cascade-path.com/wp-content/uploads/2026/04/5be3e43438472a1e02681046bd9df954-2048x1509.png" />
        <h3>ロゴデザイン</h3>
        <WorksImg SRC="https://portfolio.cascade-path.com/wp-content/uploads/2026/04/ce26d79c1f462571bc7a71fd86f0a55c-2048x1265.png" />
        <h3>バナーデザイン</h3>
        <WorksImg SRC="https://portfolio.cascade-path.com/wp-content/uploads/2026/04/b59c18fa190e3b40319295a1f28d7b12-2048x1454.png" />
        <WorksImg SRC="https://portfolio.cascade-path.com/wp-content/uploads/2026/04/45367e1ca4a5c9ae6e8b285ac8518ed6-2048x1525.png" />
        <h2>まとめ</h2>
        <BtnBack HREF="/works">一覧に戻る</BtnBack>
    </Main>
    <Footer />
</Layout>
