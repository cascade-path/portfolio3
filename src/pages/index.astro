---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Damy from '../components/Damy.astro';
import Hero from '../components/Hero.astro';
import ScrollSnap from '../components/ScrollSnap.astro';
import BtnBack from '../components/ui/BtnBack.astro';
---

<Layout title="cascade-path 3.0">
	<Hero />
	<ScrollSnap>
		<div class="scroll-snap-item">Section 1</div>
		<div class="scroll-snap-item">Section 2</div>
		<div class="scroll-snap-item">Section 3</div>
		<div class="scroll-snap-item">Section 4</div>
	</ScrollSnap>
	<div class="temp-msg">
		<div>
			<div>ここはMV用の予約ページです。</div>
			<div><a href="/top" class="temp-link">次のページ</a>にお進みください。</div>
			<BtnBack HREF="/top">top</BtnBack>
		</div>
	</div>
	<Damy />
	<Footer />
</Layout>

<style>
	.temp-msg{
		display: grid;
		place-items: center;
		height: 300px;
		font-size: 1.5rem;
	}
	.temp-link{
		color: var(--main);
		text-decoration: none;
	}
	.temp-link:hover{
		text-decoration: underline;
	}
	.scroll-snap-item{
		display: flex;
		align-items: center;
		justify-content: center;
		height: 50vh;
		font-size: 2rem;
		background-color: var(--accent);
		border-radius: 0.5rem;
		box-shadow: 0 0 8px var(--accent);
		color: var(--base);
		scroll-snap-align: center;
	}
	
</style>