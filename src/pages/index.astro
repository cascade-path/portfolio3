---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Damy from '../components/Damy.astro';
import Hero from '../components/Hero.astro';
import ScrollSnap from '../components/ScrollSnap.astro';
---

<Layout title="cascade-path 3.0">
	<Hero />
	<ScrollSnap>
		<div class="scroll-snap-item">Section 1</div>
		<div class="scroll-snap-item">Section 2</div>
		<div class="scroll-snap-item">Section 3</div>
		<div class="scroll-snap-item">Section 4</div>
	</ScrollSnap>
	<Section />
	<Damy />
	<Footer />
</Layout>

<style>
	.scroll-snap-item{
		display: flex;
		align-items: center;
		justify-content: center;
		height: 50vh;
		font-size: 2rem;
		background-color: var(--accent);
		border-radius: 0.5rem;
		box-shadow: 0 0 8px var(--accent);
		color: var(--base);
		scroll-snap-align: center;
	}
	
</style>