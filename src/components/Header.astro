---
import Hamburger from './ui/Hamburger.astro';
import HeaderNavHoverMenu from './ui/HeaderNavHoverMenu.astro';
---

<header data-static>
    <div class="logo">
        <a href="/" class="logo-link">
            <img src="/logo.svg" alt="Cascade-path Logo">
        </a>
    </div>
    <div style="height:300px"></div>
    <nav>
        <a href="/" data-ja="トップ">top</a>
        <a href="/about" data-ja="概要">about</a>
        <a href="/skills" data-ja="スキル">skill</a>
        <a href="/works" data-ja="作品">works</a>
        <a href="/contact" data-ja="お問い合わせ">contact</a>
    </nav>
    <Hamburger />
    <HeaderNavHoverMenu />
</header>
<header data-scrolled>
    <div class="logo">
        <a href="/" class="logo-link"> 
            <img src="/logo.svg" alt="Cascade-path Logo">
        </a>
    </div>
    <nav>
        <a href="/" data-ja>top</a>
        <a href="/about" data-ja>about</a>
        <a href="/skills" data-ja>skills</a>
        <a href="/works" data-ja>works</a>
        <a href="/contact" data-ja>contact</a>
    </nav>
    <Hamburger />
    <HeaderNavHoverMenu />
</header>

<style>
    header{
        display: grid;
        grid-template-columns: 200px 1fr 60px;
        position: relative;
    }
    header nav{
        display: grid;
        grid-auto-flow: column;
        gap: 3px;
        width: 100%;
        grid-column: 2/4;
        background: linear-gradient(180deg,var(--main) 0% 10%,var(--accent),var(--main) 90% 100%);
    }
    header nav a{
        display: grid;
        place-items: center;
        background: var(--main);
        color: unset;
        text-decoration: unset;
    }
    header nav a:hover{
        background-opacity: .5;
        opacity: .8;
        color: var(--main);
        text-shadow: 0 0 5px var(--accent);
        transition: color .2s, text-shadow .2s;
    }

    header[data-static]{
        grid-template-rows: 60px 200px 60px;
        background: var(--main);
        position: relative;
        z-index: 1;
    }
    header[data-static] nav{
        grid-row: 3/4;
    }
    .logo{
        display: grid;
        place-items: center;
        grid-column: 1/2;
        position: sticky;
        top: 0;
    }
    .logo-link{
        display: grid;
        place-items: center;
    }
    .logo img{
        width: 90%;
        height: auto;
    }

    header[data-scrolled]{
        background: var(--main);
        height: 60px;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1;
        opacity: 0;
        transform: translateY(-100%);
        transition: transform .5s 1s, opacity .5s 0s;
    }
    header[data-scrolled][data-fixed="true"]{
        opacity: 1;
        transform: translateY(0%);
        transition: transform .5s .5s, opacity .5s .5s;
        z-index: 2;
    }
    @media (max-width: 600px){
        :is(header[data-scrolled],header[data-static]) nav{
            display: none;
        }

    }
</style>