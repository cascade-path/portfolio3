---

<header data-static>
    <div class="logo">
        <img src="/logo.svg" alt="Cascade-path Logo">
    </div>
    <div style="height:300px"></div>
    <nav>
        <a href="/">top</a>
        <a href="/about">about</a>
        <a href="/skill">skill</a>
        <a href="/works">works</a>
        <a href="/contact">contact</a>
    </nav>
</header>
<header data-scrolled>
    <div class="logo">
        <img src="/logo.svg" alt="Cascade-path Logo">
    </div>
    <nav>
        <a href="/">top</a>
        <a href="/about">about</a>
        <a href="/skill">skill</a>
        <a href="/works">works</a>
        <a href="/contact">contact</a>
    </nav>
</header>

<style>
    header{
        display: grid;
        grid-template-columns: 200px 1fr;
    }
    header nav{
        display: grid;
        grid-auto-flow: column;
        gap: 3px;
        width: 100%;
        background: linear-gradient(180deg,var(--main) 0% 10%,var(--accent) 10% 90%,var(--main) 90% 100%);
    }
    header nav a{
        display: grid;
        place-items: center;
        background: var(--main);
        color: unset;
        text-decoration: unset;
    }
    header nav a:hover{
        background-opacity: .5;
        opacity: .8;
        color: var(--main);
        text-shadow: 0 0 5px var(--accent);
        transition: color .2s, text-shadow .2s;
    }
    header[data-static]{
        grid-template-rows: 60px 200px 60px;
        background: var(--main);
        position: relative;
        z-index: 1;
    }
    header[data-static] nav{
        grid-row: 3/4;
        grid-column: 2/3;
    }
    .logo{
        display: grid;
        place-items: center;
        grid-column: 1/2;
        position: sticky;
        top: 0;
    }
    .logo img{
        width: 90%;
        height: auto;
    }

    header[data-scrolled]{
        background: var(--main);
        height: 60px;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1;
        opacity: 0;
        transform: translateY(-100%);
        transition: transform .5s 1s, opacity .5s 0s;
    }
    header[data-scrolled][data-fixed="true"]{
        opacity: 1;
        transform: translateY(0%);
        transition: transform .5s .5s, opacity .5s .5s;
        z-index: 2;
    }

</style>