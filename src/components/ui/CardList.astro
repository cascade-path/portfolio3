<div class="card-list"><slot /></div>

<style>
    .card-list{
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin: 0 auto;
        width: min(90%, 800px);
    }
    @media (max-width: 600px) {
        .card-list{
            grid-template-columns: 2fr;
        }
