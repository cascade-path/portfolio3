---
const { title, src, href } = Astro.props;
---
<a href={href} class="card">
    <img src={src} alt="card">
    <div class="content">
        <div class="title">{title}</div>
        <p>カードの説明文が入ります。カードの特徴や使用技術などを簡潔に紹介します。</p>
    </div>
</a>

<style>
    .card{
        display:grid;
        grid-template-rows: repeat(2, 1fr);
        background-color: var(--accent);
        border-radius: 0.5rem;
        box-shadow: 0 0 8px var(--accent);
        aspect-ratio: 3 / 4;
        overflow: hidden;
        color: var(--base);
        position: relative;
        transition: box-shadow .2s;
    }
    .card:hover{
        box-shadow: 0 0 12px var(--accent);
    }
    .card:hover img{
        transform: scale(1.1);
    }
    .card img{
        width: 100%;
        transition: transform .4s ease-out;
    }
    .card .title{
        margin-top: 1rem;
        padding: 0.5rem;
    }
    .card p{
        margin-top: 0.5rem;
        font-size: 1rem;
    }
    .card .content{
        position: absolute;
        top: 50%;
        padding: 1rem;
        background: var(--accent);
    }
</style>